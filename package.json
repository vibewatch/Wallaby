{
  "name": "wallaby",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, self-hosted wallabag-compatible read-it-later application.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:site-configs": "tsx scripts/verify-site-configs.ts",
    "test:e2e": "playwright test",
    "test:container": "tsx scripts/verify-container.ts",
    "test:production-config": "vitest run lib/production-config.test.ts",
    "config:validate": "tsx scripts/validate-production.ts",
    "images:cleanup": "tsx scripts/cleanup-images.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "import:worker": "tsx scripts/import-worker.ts",
    "import:worker:once": "tsx scripts/import-worker.ts --once",
    "import:file": "tsx scripts/import-file.ts",
    "import:url": "tsx scripts/import-url.ts",
    "export:library": "tsx scripts/export-library.ts",
    "entries:reload": "tsx scripts/reload-entries.ts",
    "entries:dedupe": "tsx scripts/clean-duplicates.ts",
    "oauth:create-client": "tsx scripts/create-oauth-client.ts",
    "tag:all": "tsx scripts/tag-all.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:site-configs && npm run build",
    "release": "npm run verify && npm run test:e2e && npm audit --omit=dev --audit-level=moderate && npm run db:validate && npm run test:container",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@fontsource/unifont": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.19.3",
    "@wallaby/extractor": "*",
    "bcryptjs": "3.0.2",
    "emailjs": "5.0.2",
    "fflate": "^0.8.3",
    "jsdom": "26.1.0",
    "lucide-react": "0.468.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "playwright": "1.62.1",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "safe-regex2": "^5.1.1",
    "sharp": "0.35.3",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
