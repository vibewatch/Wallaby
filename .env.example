DATABASE_URL="file:./dev.db"
# SQLite is the local default. PostgreSQL requires a client generated for it:
# DATABASE_PROVIDER=postgresql npm run db:generate
# DATABASE_URL=postgresql://wallaby:password@localhost:5432/wallaby
# Production images select DATABASE_PROVIDER at build time, not after deployment.
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_TRUST_HOST="true"
# Public origin used for OAuth callbacks and canonical authentication redirects.
# Production deployments should use HTTPS.
AUTH_URL="http://localhost:3000"
# Set the same base64 AES key on every server instance built for one deployment.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
# Optional rolling-deployment identifier, normally a commit SHA or image digest.
DEPLOYMENT_VERSION=""
# Optional dedicated AES-256-GCM key for TOTP secrets. If omitted, a strong
# AUTH_SECRET is domain-separated and hashed into the encryption key.
TWO_FACTOR_KEY="replace-with-32-byte-base64-key"
# Optional instance email. Needed for email-code 2FA and for self-service
# password reset, which is offered only when these and AUTH_URL are set.
TWO_FACTOR_SMTP_HOST="smtp.example.com"
TWO_FACTOR_SMTP_PORT="587"
TWO_FACTOR_SMTP_SECURITY="starttls"
TWO_FACTOR_SMTP_USER=""
TWO_FACTOR_SMTP_PASSWORD=""
TWO_FACTOR_EMAIL_FROM="Wallaby <no-reply@example.com>"
# Optional dedicated AES-256-GCM key for short-lived Pocket OAuth tokens. If
# omitted, a strong AUTH_SECRET is domain-separated and hashed into the key.
POCKET_TOKEN_KEY="replace-with-32-byte-base64-key"
# Persistent writable volume for downloaded article images.
WALLABY_MEDIA_DIR="./storage/media"
# Optional. Retry bot-challenged article fetches with rotating search-bot and
# browser request profiles (Googlebot, Bingbot, desktop/mobile browsers).
WALLABY_BOT_PROFILES="false"
# Optional. Render still-challenged articles in a headless browser.
# Requires the "playwright" package and its Chromium browser to be installed
# (`npx playwright install --with-deps chromium`). Enabling this implies
# WALLABY_BOT_PROFILES. Leave off unless the deployment has Chromium available.
WALLABY_BROWSER_RENDER="false"
# Optional. Required only when site credentials are enabled.
SITE_CREDENTIALS_KEY="replace-with-32-byte-base64-key"
